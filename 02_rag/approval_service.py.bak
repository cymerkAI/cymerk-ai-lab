from datetime import datetime, timezone
from typing import Any, Dict

from logs.audit_logger import log_event

from approval_store import (
    initialize_database,
    save_approval_request,
    get_approval_request,
    update_approval_status,
    list_pending_approvals as store_list_pending_approvals,
)


# ============================================================
# DATABASE INITIALIZATION
# ============================================================

initialize_database()


# ============================================================
# CONSTANTS
# ============================================================

ALLOWED_ACTIONS = {
    "create_crm_lead",
}

RESOLVED_STATUSES = {
    "approved",
    "rejected",
}


# ============================================================
# INTERNAL HELPERS
# ============================================================

def _utc_now() -> str:
    """
    Return the current UTC timestamp as an ISO-8601 string.
    """

    return datetime.now(timezone.utc).isoformat()


def _not_found_response(
    approval_id: str,
) -> Dict[str, Any]:
    """
    Standard response for an unknown approval ID.
    """

    return {
        "success": False,
        "status": "not_found",
        "approval_id": approval_id,
        "error": (
            f"Approval request '{approval_id}' "
            "was not found."
        ),
    }


def _already_resolved_response(
    approval_id: str,
    status: str,
) -> Dict[str, Any]:
    """
    Standard response for an already-resolved approval.
    """

    return {
        "success": False,
        "status": "already_resolved",
        "approval_id": approval_id,
        "error": (
            f"Approval request is already "
            f"{status}."
        ),
    }


def _invalid_action_response(
    action: str,
) -> Dict[str, Any]:
    """
    Standard response for an unsupported protected action.
    """

    return {
        "success": False,
        "status": "invalid_action",
        "error": (
            f"Unsupported approval action: {action}"
        ),
    }


# ============================================================
# REQUEST APPROVAL
# ============================================================

def request_approval(
    approval_id: str,
    action: str,
    lead: Dict[str, Any],
    created_at: str,
) -> Dict[str, Any]:
    """
    Create a new pending human approval request.

    This function records approval state only.

    It does NOT execute the protected action.
    """

    # --------------------------------------------------------
    # VALIDATE ACTION
    # --------------------------------------------------------

    if action not in ALLOWED_ACTIONS:
        return _invalid_action_response(action)

    # --------------------------------------------------------
    # PREVENT DUPLICATE APPROVAL IDS
    # --------------------------------------------------------

    existing = get_approval_request(
        approval_id
    )

    if existing is not None:
        return {
            "success": False,
            "status": "already_exists",
            "approval_id": approval_id,
            "error": (
                f"Approval request '{approval_id}' "
                "already exists."
            ),
        }

    # --------------------------------------------------------
    # SAVE PENDING REQUEST
    # --------------------------------------------------------

    save_approval_request(
        approval_id=approval_id,
        action=action,
        status="pending",
        lead=lead,
        created_at=created_at,
        resolved_at=None,
    )

    # --------------------------------------------------------
    # AUDIT
    # --------------------------------------------------------

    log_event(
        event_type="approval_requested",
        status="pending",
        details={
            "approval_id": approval_id,
            "action": action,
            "company": lead.get("company"),
        },
    )

    # --------------------------------------------------------
    # RESPONSE
    # --------------------------------------------------------

    return {
        "success": True,
        "status": "pending",
        "approval_id": approval_id,
        "action": action,
        "lead": lead,
        "created_at": created_at,
        "resolved_at": None,
        "message": (
            "Human approval is required before "
            "this action can be executed."
        ),
    }


# ============================================================
# GET APPROVAL
# ============================================================

def get_approval(
    approval_id: str,
) -> Dict[str, Any]:
    """
    Retrieve an approval request by ID.
    """

    request = get_approval_request(
        approval_id
    )

    if request is None:
        return _not_found_response(
            approval_id
        )

    return {
        "success": True,
        **request,
    }


# ============================================================
# LIST PENDING APPROVALS
# ============================================================

def list_pending_requests() -> Dict[str, Any]:
    """
    Return all currently pending approval requests.
    """

    requests = (
        store_list_pending_approvals()
    )

    return {
        "success": True,
        "count": len(requests),
        "requests": requests,
    }


# ============================================================
# APPROVE REQUEST
# ============================================================

def approve_request(
    approval_id: str,
) -> Dict[str, Any]:
    """
    Approve a pending request.

    This function changes approval state only.

    It does NOT execute the protected CRM action.
    """

    # --------------------------------------------------------
    # LOAD CURRENT STATE
    # --------------------------------------------------------

    request = get_approval_request(
        approval_id
    )

    if request is None:
        return _not_found_response(
            approval_id
        )

    current_status = request["status"]

    # --------------------------------------------------------
    # PREVENT DOUBLE RESOLUTION
    # --------------------------------------------------------

    if current_status != "pending":
        return _already_resolved_response(
            approval_id,
            current_status,
        )

    # --------------------------------------------------------
    # ATTEMPT ATOMIC APPROVAL
    # --------------------------------------------------------

    resolved_at = _utc_now()

    updated = update_approval_status(
        approval_id=approval_id,
        status="approved",
        resolved_at=resolved_at,
    )

    # --------------------------------------------------------
    # HANDLE FAILED ATOMIC TRANSITION
    # --------------------------------------------------------

    if not updated:

        latest = get_approval_request(
            approval_id
        )

        if latest is not None:
            latest_status = latest["status"]

            if latest_status in RESOLVED_STATUSES:
                return _already_resolved_response(
                    approval_id,
                    latest_status,
                )

        return {
            "success": False,
            "status": "update_failed",
            "approval_id": approval_id,
            "error": (
                "Approval status could not be "
                "changed to approved."
            ),
        }

    # --------------------------------------------------------
    # AUDIT
    # --------------------------------------------------------

    log_event(
        event_type="approval_granted",
        status="approved",
        details={
            "approval_id": approval_id,
            "action": request["action"],
            "company": request["lead"].get(
                "company"
            ),
        },
    )

    # --------------------------------------------------------
    # RESPONSE
    # --------------------------------------------------------

    return {
        "success": True,
        "status": "approved",
        "approval_id": approval_id,
        "action": request["action"],
        "lead": request["lead"],
        "created_at": request["created_at"],
        "resolved_at": resolved_at,
        "message": "Human approval granted.",
    }


# ============================================================
# REJECT REQUEST
# ============================================================

def reject_request(
    approval_id: str,
) -> Dict[str, Any]:
    """
    Reject a pending request.

    This function changes approval state only.

    No protected action is executed.
    """

    # --------------------------------------------------------
    # LOAD CURRENT STATE
    # --------------------------------------------------------

    request = get_approval_request(
        approval_id
    )

    if request is None:
        return _not_found_response(
            approval_id
        )

    current_status = request["status"]

    # --------------------------------------------------------
    # PREVENT DOUBLE RESOLUTION
    # --------------------------------------------------------

    if current_status != "pending":
        return _already_resolved_response(
            approval_id,
            current_status,
        )

    # --------------------------------------------------------
    # ATTEMPT ATOMIC REJECTION
    # --------------------------------------------------------

    resolved_at = _utc_now()

    updated = update_approval_status(
        approval_id=approval_id,
        status="rejected",
        resolved_at=resolved_at,
    )

    # --------------------------------------------------------
    # HANDLE FAILED ATOMIC TRANSITION
    # --------------------------------------------------------

    if not updated:

        latest = get_approval_request(
            approval_id
        )

        if latest is not None:
            latest_status = latest["status"]

            if latest_status in RESOLVED_STATUSES:
                return _already_resolved_response(
                    approval_id,
                    latest_status,
                )

        return {
            "success": False,
            "status": "update_failed",
            "approval_id": approval_id,
            "error": (
                "Approval status could not be "
                "changed to rejected."
            ),
        }

    # --------------------------------------------------------
    # AUDIT
    # --------------------------------------------------------

    log_event(
        event_type="approval_rejected",
        status="rejected",
        details={
            "approval_id": approval_id,
            "action": request["action"],
            "company": request["lead"].get(
                "company"
            ),
        },
    )

    # --------------------------------------------------------
    # RESPONSE
    # --------------------------------------------------------

    return {
        "success": True,
        "status": "rejected",
        "approval_id": approval_id,
        "action": request["action"],
        "lead": request["lead"],
        "created_at": request["created_at"],
        "resolved_at": resolved_at,
        "message": (
            "Human approval rejected. "
            "No protected action was executed."
        ),
    }